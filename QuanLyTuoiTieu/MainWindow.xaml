<Window x:Class="QuanLyTuoiTieu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:QuanLyTuoiTieu.Models"
        Title="Phần mềm quản lý giám sát nông nghiệp"
        Width="1300" Height="800" MinWidth="1200" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- ===== Thẻ thống kê ===== -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- ===== Chú giải ===== -->
        <Style x:Key="LegendChip" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- ===== Ô khu vực trong ma trận ===== -->
        <Style x:Key="ZoneCellStyle" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource EmptyFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{StaticResource EmptyBg}"
                                BorderBrush="{StaticResource EmptyBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="2">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Code}" FontSize="15" FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe UI Symbol"
                                               FontSize="12" Margin="5,2,0,0"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                           HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <!-- Ô không khớp tìm kiếm/lọc thì mờ đi -->
                            <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.25"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ZoneStatus.NotConfigured}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NotConfiguredBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NotConfiguredBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource NotConfiguredFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ZoneStatus.Normal}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NormalBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NormalBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource NormalFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ZoneStatus.Warning}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WarningBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WarningBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource WarningFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ZoneStatus.Disconnected}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisconnectedBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DisconnectedBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisconnectedFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ZoneStatus.Disabled}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Thống kê -->
            <RowDefinition Height="Auto"/>
            <!-- Chú giải -->
            <RowDefinition Height="*"/>
            <!-- Ma trận -->
            <RowDefinition Height="Auto"/>
            <!-- Thanh trạng thái -->
        </Grid.RowDefinitions>

        <!-- ===== 1. Tiêu đề ===== -->
        <Border Grid.Row="0" Background="#166534" Padding="20,14">
            <DockPanel>
                <Border x:Name="SimulatedBadge" DockPanel.Dock="Right" Background="#FEF3C7" CornerRadius="12"
                        Padding="12,4" VerticalAlignment="Center">
                    <TextBlock Text="DỮ LIỆU MÔ PHỎNG" Foreground="#92400E"
                               FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="PHẦN MỀM QUẢN LÝ GIÁM SÁT NÔNG NGHIỆP"
                               Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Quản lý và giám sát các khu vực canh tác"
                               Foreground="#BBF7D0" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 2. Thống kê tổng quan (binding tới FarmSummary) ===== -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="12,12,12,0">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Tổng số khu vực"/>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalZones}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Hoạt động bình thường"/>
                    <TextBlock Style="{StaticResource StatValue}" Foreground="#166534" Text="{Binding NormalZones}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Khu vực có cảnh báo"/>
                    <TextBlock Style="{StaticResource StatValue}" Foreground="#B45309" Text="{Binding WarningZones}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Khu vực mất kết nối"/>
                    <TextBlock Style="{StaticResource StatValue}" Foreground="#B91C1C" Text="{Binding DisconnectedZones}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Tổng số cảm biến"/>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalSensors}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Cảm biến hoạt động"/>
                    <TextBlock Style="{StaticResource StatValue}" Foreground="#166534" Text="{Binding ActiveSensors}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Cảm biến lỗi"/>
                    <TextBlock Style="{StaticResource StatValue}" Foreground="#B91C1C" Text="{Binding FaultySensors}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== 3. Chú giải trạng thái ===== -->
        <WrapPanel Grid.Row="2" Margin="16,12,16,0">
            <TextBlock Text="Chú giải:" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>

            <Border Style="{StaticResource LegendChip}"
                    Background="{StaticResource NormalBg}" BorderBrush="{StaticResource NormalBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔" FontFamily="Segoe UI Symbol" Foreground="{StaticResource NormalFg}" Margin="0,0,5,0"/>
                    <TextBlock Text="Bình thường" Foreground="{StaticResource NormalFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LegendChip}"
                    Background="{StaticResource WarningBg}" BorderBrush="{StaticResource WarningBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontFamily="Segoe UI Symbol" Foreground="{StaticResource WarningFg}" Margin="0,0,5,0"/>
                    <TextBlock Text="Cảnh báo" Foreground="{StaticResource WarningFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LegendChip}"
                    Background="{StaticResource DisconnectedBg}" BorderBrush="{StaticResource DisconnectedBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" FontFamily="Segoe UI Symbol" Foreground="{StaticResource DisconnectedFg}" Margin="0,0,5,0"/>
                    <TextBlock Text="Mất kết nối" Foreground="{StaticResource DisconnectedFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LegendChip}"
                    Background="{StaticResource NotConfiguredBg}" BorderBrush="{StaticResource NotConfiguredBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="○" FontFamily="Segoe UI Symbol" Foreground="{StaticResource NotConfiguredFg}" Margin="0,0,5,0"/>
                    <TextBlock Text="Chưa cấu hình" Foreground="{StaticResource NotConfiguredFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LegendChip}"
                    Background="{StaticResource DisabledBg}" BorderBrush="{StaticResource DisabledBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⊘" FontFamily="Segoe UI Symbol" Foreground="{StaticResource DisabledFg}" Margin="0,0,5,0"/>
                    <TextBlock Text="Ngừng hoạt động" Foreground="{StaticResource DisabledFg}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LegendChip}"
                    Background="{StaticResource EmptyBg}" BorderBrush="{StaticResource EmptyBorder}">
                <TextBlock Text="Trống (chưa có khu vực)" Foreground="{StaticResource EmptyFg}"/>
            </Border>
        </WrapPanel>

        <!-- ===== 4. Ma trận khu vực (kèm thanh công cụ) ===== -->
        <Border Grid.Row="3" Margin="12" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="16,12,16,4" FontWeight="SemiBold" FontSize="14"
                           Text="SƠ ĐỒ KHU VỰC (12 hàng × 12 cột, tối đa 144 khu vực)"/>

                <!-- Thanh công cụ -->
                <WrapPanel DockPanel.Dock="Top" Margin="16,4,16,8">
                    <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,2,6,2"/>
                    <TextBox x:Name="SearchBox" Width="200" Padding="4,4" Margin="0,2,0,2"
                             VerticalContentAlignment="Center"
                             ToolTip="Nhập mã (ví dụ A01) hoặc tên khu vực"
                             TextChanged="SearchBox_TextChanged"/>

                    <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="16,2,6,2"/>
                    <ComboBox x:Name="StatusFilter" Width="170" Padding="6,4" Margin="0,2,0,2"
                              SelectedIndex="0" SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBoxItem Tag="All" Content="Tất cả"/>
                        <ComboBoxItem Tag="Normal" Content="Bình thường"/>
                        <ComboBoxItem Tag="Warning" Content="Cảnh báo"/>
                        <ComboBoxItem Tag="Disconnected" Content="Mất kết nối"/>
                        <ComboBoxItem Tag="NotConfigured" Content="Chưa cấu hình"/>
                        <ComboBoxItem Tag="Disabled" Content="Ngừng hoạt động"/>
                        <ComboBoxItem Tag="Empty" Content="Ô trống (chưa có khu vực)"/>
                    </ComboBox>

                    <Button Content="Xóa bộ lọc" Padding="12,4" Margin="10,2,0,2" Click="ClearFilter_Click"/>
                    <Button Content="+ Thêm khu vực" Padding="12,4" Margin="24,2,0,2" Click="AddZone_Click"/>
                    <Button x:Name="RefreshButton" Content="Làm mới dữ liệu" Padding="12,4" Margin="8,2,0,2"
                            Click="Refresh_Click"/>
                    <Button Content="Thông tin đồng bộ" Padding="12,4" Margin="8,2,0,2" Click="SyncInfo_Click"/>
                    <Button Content="Danh sách ESP32" Padding="12,4" Margin="8,2,0,2" Click="NodeList_Click"/>
                    <TextBlock x:Name="ResultText" Foreground="#6B7280" VerticalAlignment="Center" Margin="20,2,0,2"/>
                </WrapPanel>
                <!-- Đồng bộ tự động và công cụ thử nghiệm -->
                <WrapPanel DockPanel.Dock="Top" Margin="16,0,16,8">
                    <CheckBox x:Name="AutoSyncCheck" Content="Tự động đồng bộ" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,2,0,2"
                              Checked="AutoSync_Changed" Unchecked="AutoSync_Changed"/>
                    <TextBlock x:Name="NextSyncText" Foreground="#6B7280" VerticalAlignment="Center"
                               Margin="12,2,0,2"/>

                    <Border x:Name="SimulationPanel" Background="#FEF3C7" BorderBrush="#FCD34D"
                            BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="24,2,0,2">
                        <WrapPanel>
                            <TextBlock Text="Thử nghiệm (mô phỏng):" Foreground="#92400E"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,10,2"/>
                            <CheckBox x:Name="SimErrorCheck" Content="Lỗi đồng bộ" VerticalAlignment="Center"
                                      Margin="0,2,10,2" Checked="Simulation_Changed" Unchecked="Simulation_Changed"
                                      ToolTip="Lần đồng bộ sau sẽ thất bại ngay với thông báo lỗi"/>
                            <CheckBox x:Name="SimDisconnectedCheck" Content="Mất kết nối" VerticalAlignment="Center"
                                      Margin="0,2,10,2" Checked="Simulation_Changed" Unchecked="Simulation_Changed"
                                      ToolTip="Lần đồng bộ sau không có phản hồi, chờ hết thời gian chờ (30 giây) rồi báo thất bại"/>
                            <Button Content="Tua dữ liệu cũ thêm 1 giờ" Padding="10,2" Margin="0,2,8,2"
                                    Click="AgeData_Click"
                                    ToolTip="Làm mọi giá trị đo cũ thêm 1 giờ ngay lập tức, để xem trạng thái 'Dữ liệu đã cũ' và 'Mất kết nối'"/>
                            <Button Content="Tạo đủ 144 khu vực mẫu" Padding="10,2" Margin="0,2,8,2"
                                    Click="FillZones_Click"
                                    ToolTip="Điền mọi ô còn trống bằng khu vực mẫu kèm ESP32 và cảm biến mô phỏng, để thử với 144 khu vực"/>
                            <Button Content="Đặt lại dữ liệu mẫu" Padding="10,2" Margin="0,2,0,2"
                                    Click="ResetSample_Click"
                                    ToolTip="Quay về 48 khu vực mẫu ban đầu. Mọi thay đổi của bạn sẽ mất"/>
                        </WrapPanel>
                    </Border>
                </WrapPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ZoneMatrix" Margin="8,0,8,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ZoneCellStyle}" Height="60"
                                        ToolTip="{Binding ToolTipText}"
                                        Click="ZoneCell_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== 5. Thanh trạng thái ===== -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock x:Name="SyncStatusText" DockPanel.Dock="Right" Foreground="#6B7280"/>
                <TextBlock x:Name="SourceText" Foreground="#6B7280" Margin="0,0,16,0"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>