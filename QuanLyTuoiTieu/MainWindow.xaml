<Window x:Class="QuanLyTuoiTieu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:QuanLyTuoiTieu.Models"
        Title="Phần mềm quản lý giám sát nông nghiệp"
        Width="1300" Height="800" MinWidth="1200" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- ===== Thẻ thống kê ===== -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- ===== Chú giải (chip có nền màu) ===== -->
        <Style x:Key="LegendChip" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- ===== Nút chính (nền xanh) ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#166534"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14532D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Ô khu vực trong ma trận: mã + biểu tượng, dưới là tên khu vực ===== -->
        <Style x:Key="ZoneCellStyle" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource EmptyFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{StaticResource EmptyBg}"
                                BorderBrush="{StaticResource EmptyBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="2">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Code}" FontSize="15" FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe UI Symbol"
                                               FontSize="12" Margin="5,2,0,0"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </StackPanel>
                                <!-- Tên khu vực: tối đa 2 dòng, hết chỗ mới dùng dấu ... -->
                                <TextBlock Text="{Binding NameText}" FontSize="10.5" Margin="2,1,2,0"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineHeight="13" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="26"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <!-- Ô không khớp tìm kiếm/lọc thì mờ đi -->
                            <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.25"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ZoneStatus.NotConfigured}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NotConfiguredBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NotConfiguredBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource NotConfiguredFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ZoneStatus.Normal}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NormalBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NormalBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource NormalFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ZoneStatus.Warning}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WarningBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WarningBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource WarningFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ZoneStatus.Disconnected}">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisconnectedBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DisconnectedBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisconnectedFg}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Thống kê -->
            <RowDefinition Height="*"/>
            <!-- Khung sơ đồ -->
            <RowDefinition Height="Auto"/>
            <!-- Thanh dưới cùng -->
        </Grid.RowDefinitions>

        <!-- ===== 1. Thanh tiêu đề ===== -->
        <Border Grid.Row="0" Background="#166534" Padding="20,10">
            <DockPanel>
                <!-- Menu công cụ thử nghiệm (chỉ hiện với dữ liệu mô phỏng) -->
                <Button x:Name="TestMenuButton" DockPanel.Dock="Right" Content="Thử nghiệm ▾"
                        Padding="12,3" Margin="10,0,0,0" VerticalAlignment="Center"
                        ToolTip="Công cụ thử nghiệm (chỉ có với dữ liệu mô phỏng)"
                        Click="TestMenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="TestMenu">
                            <MenuItem x:Name="SimDisconnectedItem" Header="Giả lập mất kết nối"
                                      IsCheckable="True"
                                      ToolTip="Lần đồng bộ sau không có phản hồi, chờ hết thời gian chờ (30 giây) rồi báo thất bại"
                                      Checked="Simulation_Changed" Unchecked="Simulation_Changed"/>
                            <Separator/>
                            <MenuItem Header="Tua dữ liệu thành cũ" Click="AgeData_Click"
                                      ToolTip="Làm mọi giá trị đo cũ thêm (ngưỡng dữ liệu cũ + 1 phút) ngay lập tức, để xem trạng thái dữ liệu cũ và mất kết nối"/>
                            <MenuItem Header="Tạo đủ 144 khu vực mẫu" Click="FillZones_Click"
                                      ToolTip="Điền mọi ô còn trống bằng khu vực mẫu kèm ESP32 và cảm biến mô phỏng"/>
                            <MenuItem Header="Đặt lại dữ liệu mẫu" Click="ResetSample_Click"
                                      ToolTip="Quay về 48 khu vực mẫu ban đầu. Mọi thay đổi của bạn sẽ mất"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Border x:Name="SimulatedBadge" DockPanel.Dock="Right" Background="#FEF3C7" CornerRadius="12"
                        Padding="12,4" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DỮ LIỆU MÔ PHỎNG" Foreground="#92400E" FontWeight="SemiBold" FontSize="12"/>
                </Border>

                <!-- Nhắc đang giả lập mất kết nối (chỉ hiện khi bật) -->
                <Border x:Name="SimWarnBadge" DockPanel.Dock="Right" Visibility="Collapsed"
                        Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="12"
                        Padding="12,3" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ĐANG GIẢ LẬP MẤT KẾT NỐI" Foreground="#991B1B"
                               FontWeight="SemiBold" FontSize="12"/>
                </Border>

                <TextBlock Text="PHẦN MỀM QUẢN LÝ GIÁM SÁT NÔNG NGHIỆP" Foreground="White"
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ===== 2. Thẻ thống kê (hai nhóm: khu vực, cảm biến) ===== -->
        <Grid Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Columns="4">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Tổng số khu vực"/>
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalZones}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Hoạt động bình thường"/>
                        <TextBlock Style="{StaticResource StatValue}" Foreground="#166534" Text="{Binding NormalZones}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Khu vực có cảnh báo"/>
                        <TextBlock Style="{StaticResource StatValue}" Foreground="#B45309" Text="{Binding WarningZones}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Khu vực mất kết nối"/>
                        <TextBlock Style="{StaticResource StatValue}" Foreground="#B91C1C" Text="{Binding DisconnectedZones}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Grid.Column="2" Columns="3">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Tổng số cảm biến"/>
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalSensors}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Cảm biến hoạt động"/>
                        <TextBlock Style="{StaticResource StatValue}" Foreground="#166534" Text="{Binding ActiveSensors}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Cảm biến lỗi"/>
                        <TextBlock Style="{StaticResource StatValue}" Foreground="#B91C1C" Text="{Binding FaultySensors}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>

        <!-- ===== 3. Khung sơ đồ khu vực =====
             Mã trong MainWindow.xaml.cs đặt chiều cao ma trận (ZoneMatrix.Height) bằng số nguyên hàng
             để không bao giờ thấy nửa hàng. -->
        <Grid x:Name="MatrixHost" Grid.Row="2" Margin="12,8,12,8" SizeChanged="MatrixHost_SizeChanged">
            <Border x:Name="MatrixFrame" VerticalAlignment="Top" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="8" Padding="0,0,0,4">
                <DockPanel>

                    <!-- Dòng 1: tiêu đề sơ đồ + chú giải 5 trạng thái -->
                    <DockPanel DockPanel.Dock="Top" Margin="16,10,16,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource LegendChip}"
                                    Background="{StaticResource NormalBg}" BorderBrush="{StaticResource NormalBorder}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✔" FontFamily="Segoe UI Symbol" Foreground="{StaticResource NormalFg}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Bình thường" Foreground="{StaticResource NormalFg}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource LegendChip}"
                                    Background="{StaticResource WarningBg}" BorderBrush="{StaticResource WarningBorder}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontFamily="Segoe UI Symbol" Foreground="{StaticResource WarningFg}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Cảnh báo" Foreground="{StaticResource WarningFg}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource LegendChip}"
                                    Background="{StaticResource DisconnectedBg}" BorderBrush="{StaticResource DisconnectedBorder}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✖" FontFamily="Segoe UI Symbol" Foreground="{StaticResource DisconnectedFg}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Mất kết nối" Foreground="{StaticResource DisconnectedFg}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource LegendChip}"
                                    Background="{StaticResource NotConfiguredBg}" BorderBrush="{StaticResource NotConfiguredBorder}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="○" FontFamily="Segoe UI Symbol" Foreground="{StaticResource NotConfiguredFg}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Chưa cấu hình" Foreground="{StaticResource NotConfiguredFg}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource LegendChip}"
                                    Background="{StaticResource EmptyBg}" BorderBrush="{StaticResource EmptyBorder}">
                                <TextBlock Text="Trống (chưa có khu vực)" Foreground="{StaticResource EmptyFg}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="SƠ ĐỒ KHU VỰC (12 hàng × 12 cột, tối đa 144 khu vực)"/>
                    </DockPanel>

                    <!-- Dòng 2: tìm kiếm, lọc (trái) và thao tác quản lý (phải) -->
                    <DockPanel DockPanel.Dock="Top" Margin="16,8,16,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Danh sách ESP32" Padding="12,4" Margin="0,0,8,0"
                                    Click="NodeList_Click"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="+ Thêm khu vực"
                                    Click="AddZone_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SearchBox" Width="200" Padding="4,4"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Nhập mã (ví dụ A01) hoặc tên khu vực"
                                     TextChanged="SearchBox_TextChanged"/>

                            <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <ComboBox x:Name="StatusFilter" Width="170" Padding="6,4"
                                      SelectedIndex="0" SelectionChanged="StatusFilter_SelectionChanged">
                                <ComboBoxItem Tag="All" Content="Tất cả"/>
                                <ComboBoxItem Tag="Normal" Content="Bình thường"/>
                                <ComboBoxItem Tag="Warning" Content="Cảnh báo"/>
                                <ComboBoxItem Tag="Disconnected" Content="Mất kết nối"/>
                                <ComboBoxItem Tag="NotConfigured" Content="Chưa cấu hình"/>
                                <ComboBoxItem Tag="Empty" Content="Ô trống (chưa có khu vực)"/>
                            </ComboBox>

                            <!-- Chỉ hiện khi đang có tìm kiếm hoặc lọc -->
                            <Button x:Name="ClearFilterButton" Content="Xóa bộ lọc" Padding="10,4"
                                    Margin="10,0,0,0" Visibility="Collapsed" Click="ClearFilter_Click"/>

                            <TextBlock x:Name="ResultText" Foreground="#6B7280" VerticalAlignment="Center"
                                       Margin="16,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Ma trận: cuộn theo từng hàng (mỗi mục là một hàng 12 ô) -->
                    <ItemsControl x:Name="ZoneMatrix" Margin="8,0,8,0"
                                  PreviewMouseWheel="ZoneMatrix_PreviewMouseWheel">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer x:Name="MatrixScroll" CanContentScroll="True" Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Một hàng: 12 ô, cao đúng 66 px (ô 60 + lề 3 + 3) -->
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ZoneCellStyle}" Height="60"
                                                    ToolTip="{Binding ToolTipText}"
                                                    Click="ZoneCell_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 4. Thanh dưới cùng: nguồn dữ liệu và đồng bộ ===== -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                Padding="16,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SourceText" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Border Width="1" Background="#E5E7EB" Margin="12,2,12,2"/>
                    <Button x:Name="RefreshButton" Content="Làm mới dữ liệu" Padding="10,2" MinWidth="120"
                            Click="Refresh_Click"/>

                    <!-- Chu kỳ đồng bộ tự chọn: ô số + đơn vị phút/giờ -->
                    <CheckBox x:Name="AutoSyncCheck" Content="Tự đồng bộ mỗi" IsChecked="True"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              Checked="AutoSync_Changed" Unchecked="AutoSync_Changed"/>
                    <TextBox x:Name="IntervalBox" Width="52" Margin="8,0,0,0" Padding="3,2" MaxLength="8"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             ToolTip="Nhập chu kỳ (từ 1 phút đến 24 giờ) rồi nhấn Enter"
                             KeyDown="IntervalBox_KeyDown" LostFocus="IntervalBox_LostFocus"/>
                    <ComboBox x:Name="UnitCombo" Width="68" Margin="6,0,0,0" Padding="6,2" SelectedIndex="0"
                              SelectionChanged="UnitCombo_SelectionChanged">
                        <ComboBoxItem Content="phút"/>
                        <ComboBoxItem Content="giờ"/>
                    </ComboBox>
                    <TextBlock x:Name="NextSyncText" Foreground="#6B7280" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Kết quả đồng bộ; nhấn để xem thông tin chi tiết -->
                <TextBlock x:Name="SyncStatusText" Foreground="#6B7280" VerticalAlignment="Center"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="16,0,0,0"
                           Background="Transparent" Cursor="Hand"
                           ToolTip="Nhấn để xem thông tin đồng bộ chi tiết"
                           MouseLeftButtonUp="SyncStatus_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>