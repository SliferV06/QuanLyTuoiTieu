<Application x:Class="QuanLyTuoiTieu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ===== Bảng màu trạng thái dùng chung (nền / chữ / viền) ===== -->
        <SolidColorBrush x:Key="NotConfiguredBg" Color="#E0E7FF"/>
        <SolidColorBrush x:Key="NotConfiguredFg" Color="#3730A3"/>
        <SolidColorBrush x:Key="NotConfiguredBorder" Color="#A5B4FC"/>

        <SolidColorBrush x:Key="NormalBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="NormalFg" Color="#166534"/>
        <SolidColorBrush x:Key="NormalBorder" Color="#86EFAC"/>

        <SolidColorBrush x:Key="WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="WarningFg" Color="#92400E"/>
        <SolidColorBrush x:Key="WarningBorder" Color="#FCD34D"/>

        <SolidColorBrush x:Key="DisconnectedBg" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="DisconnectedFg" Color="#991B1B"/>
        <SolidColorBrush x:Key="DisconnectedBorder" Color="#FCA5A5"/>

        <SolidColorBrush x:Key="DisabledBg" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="DisabledFg" Color="#374151"/>
        <SolidColorBrush x:Key="DisabledBorder" Color="#9CA3AF"/>

        <SolidColorBrush x:Key="EmptyBg" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="EmptyFg" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="EmptyBorder" Color="#E5E7EB"/>
    </Application.Resources>
</Application>