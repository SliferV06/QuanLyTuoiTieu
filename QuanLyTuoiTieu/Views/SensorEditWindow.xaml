<Window x:Class="QuanLyTuoiTieu.Views.SensorEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cảm biến"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        FontFamily="Segoe UI" FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="*"/>
            <!-- Nội dung (cuộn được nếu màn hình thấp) -->
            <RowDefinition Height="Auto"/>
            <!-- Nút -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#166534" Padding="20,12">
            <TextBlock x:Name="HeaderText" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,14,20,6">

                <!-- Chỉ hiện ở chế độ thay thế -->
                <Border x:Name="ReplaceInfo" Visibility="Collapsed" Background="#FEF3C7"
                        BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6"
                        Padding="10,8" Margin="0,0,0,10">
                    <TextBlock x:Name="ReplaceInfoText" Foreground="#92400E" TextWrapping="Wrap"/>
                </Border>

                <!-- Khu vực: chế độ thêm/thay thế hiện chữ, chế độ sửa hiện danh sách chọn -->
                <TextBlock Text="Khu vực lắp đặt" Foreground="#6B7280"/>
                <TextBlock x:Name="ZoneText" FontWeight="Bold" FontSize="15" Margin="0,3,0,0"/>
                <ComboBox x:Name="ZoneCombo" Visibility="Collapsed" Margin="0,4,0,0" Padding="6,4"
                          SelectionChanged="ZoneCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Name, StringFormat=' - {0}'}" Foreground="#6B7280"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Loại cảm biến *" Foreground="#6B7280" Margin="0,10,0,0"/>
                <ComboBox x:Name="TypeCombo" Margin="0,4,0,0" Padding="6,4" DisplayMemberPath="Name"
                          SelectionChanged="TypeCombo_SelectionChanged"/>
                <TextBlock x:Name="TypeHint" Foreground="#6B7280" FontSize="11.5" TextWrapping="Wrap"
                           Margin="0,3,0,0"/>

                <TextBlock Text="Mã cảm biến *" Foreground="#6B7280" Margin="0,10,0,0"/>
                <TextBox x:Name="CodeBox" Margin="0,4,0,0" Padding="4,5" MaxLength="30"/>
                <TextBlock x:Name="CodeHint" Foreground="#6B7280" FontSize="11.5" TextWrapping="Wrap"
                           Margin="0,3,0,0"/>

                <TextBlock Text="Tên cảm biến *" Foreground="#6B7280" Margin="0,10,0,0"/>
                <TextBox x:Name="NameBox" Margin="0,4,0,0" Padding="4,5" MaxLength="100"/>

                <TextBlock Text="ESP32 phụ trách *" Foreground="#6B7280" Margin="0,10,0,0"/>
                <ComboBox x:Name="NodeCombo" Margin="0,4,0,0" Padding="6,4" DisplayMemberPath="Id"
                          SelectionChanged="NodeCombo_SelectionChanged"/>
                <TextBlock x:Name="NodeHint" Foreground="#6B7280" FontSize="11.5" TextWrapping="Wrap"
                           Margin="0,3,0,0"/>

                <TextBlock Text="Đơn vị đo *" Foreground="#6B7280" Margin="0,10,0,0"/>
                <TextBox x:Name="UnitBox" Margin="0,4,0,0" Padding="4,5" MaxLength="20"/>

                <!-- Chỉ hiện ở chế độ sửa -->
                <StackPanel x:Name="StatusPanel" Visibility="Collapsed">
                    <TextBlock Text="Trạng thái cảm biến" Foreground="#6B7280" Margin="0,10,0,0"/>
                    <ComboBox x:Name="StatusCombo" Margin="0,4,0,0" Padding="6,4" SelectedIndex="0">
                        <ComboBoxItem Tag="Active" Content="Đang hoạt động"/>
                        <ComboBoxItem Tag="Faulty" Content="Có lỗi"/>
                    </ComboBox>
                    <TextBlock Foreground="#6B7280" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Để ngừng hẳn cảm biến (hỏng, đã tháo), dùng nút Gỡ cảm biến hoặc Thay thế trong cửa sổ chi tiết khu vực."/>
                </StackPanel>

                <TextBlock Text="Ghi chú kỹ thuật (không bắt buộc)" Foreground="#6B7280" Margin="0,10,0,0"/>
                <TextBox x:Name="NotesBox" Margin="0,4,0,0" Padding="4,5" Height="50"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         MaxLength="500"/>

               
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#991B1B"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                Padding="16,10" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Lưu" IsDefault="True" Width="90" Padding="12,5"
                        Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="Hủy" IsCancel="True" Width="90" Padding="12,5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>