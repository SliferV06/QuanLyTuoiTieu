<Window x:Class="QuanLyTuoiTieu.Views.ZoneDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:QuanLyTuoiTieu.Models"
        Title="Chi tiết khu vực"
        Width="1100" Height="640" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        FontFamily="Segoe UI, Segoe UI Symbol" FontSize="13">

    <Window.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,24,4"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Thông tin khu vực -->
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề danh sách cảm biến -->
            <RowDefinition Height="*"/>
            <!-- Lưới thẻ cảm biến -->
            <RowDefinition Height="Auto"/>
            <!-- Chân cửa sổ -->
        </Grid.RowDefinitions>

        <!-- ===== 1. Tiêu đề ===== -->
        <Border Grid.Row="0" Background="#166534" Padding="20,14">
            <DockPanel>
                <Border x:Name="StatusBadge" DockPanel.Dock="Right" BorderThickness="1"
                        CornerRadius="12" Padding="14,5" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="{Binding StatusLabel}"
                               FontWeight="SemiBold" FontFamily="Segoe UI, Segoe UI Symbol"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Code, StringFormat='Chi tiết khu vực {0}'}"
                               Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Name}" Foreground="#BBF7D0" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 2. Thông tin khu vực ===== -->
        <Border Grid.Row="1" Margin="12,12,12,0" Padding="16,10" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Mã khu vực:"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding Code}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="Tên khu vực:"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource InfoValue}" Text="{Binding Name}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Mô tả:"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding DescriptionText}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="ESP32 liên quan:"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource InfoValue}" Text="{Binding NodesText}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Số cảm biến:"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding ActiveSensorCount}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="Tình trạng dữ liệu:"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource InfoValue}" Text="{Binding DataSummaryText}"/>
            </Grid>
        </Border>

        <!-- ===== 3. Tiêu đề danh sách cảm biến + công tắc ước tính ===== -->
        <DockPanel Grid.Row="2" Margin="16,12,16,6">
            <CheckBox x:Name="EstimateCheck" DockPanel.Dock="Right" Content="Ước tính khi cảm biến lỗi"
                      VerticalAlignment="Center" IsChecked="True"
                      ToolTip="Khi cảm biến lỗi, hiển thị giá trị ước tính (trung bình cảm biến cùng loại ở khu vực lân cận, cần ít nhất 4 nguồn). Giá trị này không phải số đo thật."
                      Checked="Estimate_Changed" Unchecked="Estimate_Changed"/>
            <TextBlock Text="DANH SÁCH CẢM BIẾN" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock x:Name="HintText" Foreground="#92400E" FontSize="12" VerticalAlignment="Center"
                       Margin="16,0,16,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- ===== 4. Lưới thẻ cảm biến: thẻ sáng = đã kết nối, thẻ mờ = chưa ===== -->
        <ScrollViewer Grid.Row="3" Margin="6,0,6,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="TileBorder" Margin="6" Padding="14,10" CornerRadius="8"
                                Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                ToolTip="{Binding TooltipText}"
                                MouseLeftButtonUp="Tile_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" FontSize="14"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="ValueBlock" Text="{Binding ValueText}" FontSize="28"
                                               FontWeight="Bold" Foreground="#111827"/>
                                    <TextBlock Text="{Binding UnitText}" FontSize="14" Foreground="#6B7280"
                                               VerticalAlignment="Bottom" Margin="6,0,0,5"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MeasuredText}" Foreground="#6B7280" FontSize="12"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StatusBlock" Text="{Binding StatusText}" FontWeight="SemiBold"
                                           FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FooterText}" Foreground="#6B7280" FontSize="11.5"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <!-- Thông báo giá trị ước tính (chỉ hiện khi có nội dung) -->
                                <TextBlock x:Name="NoticeBlock" Text="{Binding NoticeText}" Visibility="Collapsed"
                                           Foreground="#6B7280" FontSize="11.5" FontStyle="Italic"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- Chế độ mô phỏng: thẻ bấm được -->
                            <DataTrigger Binding="{Binding IsClickable}" Value="True">
                                <Setter TargetName="TileBorder" Property="Cursor" Value="Hand"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding HasNotice}" Value="True">
                                <Setter TargetName="NoticeBlock" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <!-- Màu theo trạng thái dữ liệu (thẻ sáng) -->
                            <DataTrigger Binding="{Binding DataStatus}" Value="{x:Static m:DataStatus.Fresh}">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource NormalBorder}"/>
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="StatusBlock" Property="Foreground" Value="{StaticResource NormalFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataStatus}" Value="{x:Static m:DataStatus.Stale}">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource WarningBorder}"/>
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="StatusBlock" Property="Foreground" Value="{StaticResource WarningFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataStatus}" Value="{x:Static m:DataStatus.Error}">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource DisconnectedBorder}"/>
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="StatusBlock" Property="Foreground" Value="{StaticResource DisconnectedFg}"/>
                                <Setter TargetName="ValueBlock" Property="Foreground" Value="{StaticResource DisconnectedFg}"/>
                            </DataTrigger>

                            <!-- Giá trị ƯỚC TÍNH: nghiêng, màu cam (đặt sau trigger Error để ghi đè màu đỏ) -->
                            <DataTrigger Binding="{Binding IsEstimated}" Value="True">
                                <Setter TargetName="ValueBlock" Property="Foreground" Value="{StaticResource WarningFg}"/>
                                <Setter TargetName="ValueBlock" Property="FontStyle" Value="Italic"/>
                                <Setter TargetName="NoticeBlock" Property="Foreground" Value="{StaticResource WarningFg}"/>
                            </DataTrigger>

                            <!-- Thẻ mờ (đặt cuối để ghi đè): chưa kết nối -->
                            <DataTrigger Binding="{Binding IsLit}" Value="False">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="TileBorder" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="StatusBlock" Property="Foreground" Value="#6B7280"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== 5. Chân cửa sổ ===== -->
        <Border Grid.Row="4" Margin="0,12,0,0" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đóng" Width="100" Padding="12,5"
                        Click="Close_Click"/>
                <Button DockPanel.Dock="Right" Content="Xóa khu vực" Width="120" Padding="12,5"
                        Margin="0,0,8,0" Click="DeleteZone_Click"/>
                <Button DockPanel.Dock="Right" Content="Sửa thông tin" Width="120" Padding="12,5"
                        Margin="0,0,8,0" Click="EditZone_Click"/>
                <TextBlock x:Name="FooterNote" Foreground="#6B7280" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>