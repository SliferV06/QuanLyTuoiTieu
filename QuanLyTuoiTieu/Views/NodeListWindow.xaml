<Window x:Class="QuanLyTuoiTieu.Views.NodeListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danh sách ESP32"
        Width="1280" Height="680" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Ô chữ trong bảng: tự xuống dòng -->
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>
        <!-- Bảng ESP32: chữ xám nếu ESP32 đã ngừng sử dụng -->
        <Style x:Key="NodeCell" TargetType="TextBlock" BasedOn="{StaticResource WrapCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NodeCellBold" TargetType="TextBlock" BasedOn="{StaticResource NodeCell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SensorCellBold" TargetType="TextBlock" BasedOn="{StaticResource WrapCell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Thanh công cụ -->
            <RowDefinition Height="3*"/>
            <!-- Bảng ESP32 -->
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề bảng cảm biến -->
            <RowDefinition Height="2*"/>
            <!-- Bảng cảm biến -->
            <RowDefinition Height="Auto"/>
            <!-- Chân cửa sổ -->
        </Grid.RowDefinitions>

        <!-- ===== 1. Tiêu đề ===== -->
        <Border Grid.Row="0" Background="#166534" Padding="20,14">
            <StackPanel>
                <TextBlock Text="DANH SÁCH ESP32" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Một ESP32 có thể phụ trách nhiều khu vực và nhiều cảm biến"
                           Foreground="#BBF7D0" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== 2. Thanh công cụ ===== -->
        <WrapPanel Grid.Row="1" Margin="16,12,16,8">
            <Button Content="+ Thêm ESP32" Padding="12,4" Margin="0,2,8,2" Click="AddNode_Click"/>
            <Button x:Name="EditNodeButton" Content="Sửa thông tin" Padding="12,4" Margin="0,2,8,2"
                    IsEnabled="False" Click="EditNode_Click"/>
            <Button x:Name="ToggleNodeButton" Content="Ngừng sử dụng ESP32" Padding="12,4" Margin="0,2,8,2"
                    MinWidth="150" IsEnabled="False" Click="ToggleNode_Click"/>
            <TextBlock x:Name="SummaryText" Foreground="#6B7280" VerticalAlignment="Center" Margin="16,2,0,2"/>
        </WrapPanel>

        <!-- ===== 3. Bảng ESP32 ===== -->
        <DataGrid x:Name="NodeGrid" Grid.Row="2" Margin="12,0,12,0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                  HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource GridHeader}"
                  Background="White" RowBackground="White"
                  BorderBrush="#E5E7EB" BorderThickness="1"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  FontFamily="Segoe UI, Segoe UI Symbol"
                  SelectionChanged="NodeGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã ESP32" Width="100"
                                    Binding="{Binding Id, Mode=OneWay}"
                                    ElementStyle="{StaticResource NodeCellBold}"/>
                <DataGridTextColumn Header="Tên" Width="160"
                                    Binding="{Binding Name, Mode=OneWay}"
                                    ElementStyle="{StaticResource NodeCell}"/>
                <DataGridTextColumn Header="Trạng thái" Width="150"
                                    Binding="{Binding StatusText, Mode=OneWay}"
                                    ElementStyle="{StaticResource NodeCell}"/>
                <DataGridTextColumn Header="Số khu vực" Width="95"
                                    Binding="{Binding ZoneCount, Mode=OneWay}"
                                    ElementStyle="{StaticResource NodeCell}"/>
                <DataGridTextColumn Header="Số cảm biến" Width="100"
                                    Binding="{Binding SensorCount, Mode=OneWay}"
                                    ElementStyle="{StaticResource NodeCell}"/>
                <DataGridTextColumn Header="Khu vực phụ trách" Width="*" MinWidth="180"
                                    Binding="{Binding ZonesText, Mode=OneWay}"
                                    ElementStyle="{StaticResource NodeCell}"/>
                <DataGridTextColumn Header="Dữ liệu gần nhất" Width="240"
                                    Binding="{Binding LastDataText, Mode=OneWay}"
                                    ElementStyle="{StaticResource NodeCell}"/>
                <DataGridTextColumn Header="Ngày đăng ký" Width="110"
                                    Binding="{Binding CreatedAtText, Mode=OneWay}"
                                    ElementStyle="{StaticResource NodeCell}"/>
                <DataGridTextColumn Header="Ghi chú" Width="200"
                                    Binding="{Binding NotesText, Mode=OneWay}"
                                    ElementStyle="{StaticResource NodeCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== 4. Tiêu đề bảng cảm biến ===== -->
        <TextBlock x:Name="SensorTitle" Grid.Row="3" Margin="16,12,16,6"
                   FontWeight="SemiBold" FontSize="14"/>

        <!-- ===== 5. Bảng cảm biến của ESP32 đang chọn ===== -->
        <DataGrid x:Name="SensorGrid" Grid.Row="4" Margin="12,0,12,0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                  HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource GridHeader}"
                  Background="White" RowBackground="White"
                  BorderBrush="#E5E7EB" BorderThickness="1"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã cảm biến" Width="140"
                                    Binding="{Binding Id, Mode=OneWay}"
                                    ElementStyle="{StaticResource SensorCellBold}"/>
                <DataGridTextColumn Header="Tên cảm biến" Width="220"
                                    Binding="{Binding Name, Mode=OneWay}"
                                    ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="Khu vực" Width="90"
                                    Binding="{Binding ZoneCode, Mode=OneWay}"
                                    ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="Loại cảm biến" Width="*" MinWidth="180"
                                    Binding="{Binding TypeName, Mode=OneWay}"
                                    ElementStyle="{StaticResource WrapCell}"/>
                <DataGridTextColumn Header="Trạng thái cảm biến" Width="150"
                                    Binding="{Binding StatusText, Mode=OneWay}"
                                    ElementStyle="{StaticResource WrapCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== 6. Chân cửa sổ ===== -->
        <Border Grid.Row="5" Margin="0,12,0,0" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đóng" Width="100" Padding="12,5"
                        Click="Close_Click"/>
                <TextBlock Foreground="#6B7280" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,16,0"
                           Text="Để chuyển cảm biến sang ESP32 khác, dùng Sửa cảm biến trong cửa sổ chi tiết khu vực."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>